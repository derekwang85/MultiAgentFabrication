<mxCell id="old" value="作坊式脑力劳动&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;判断在个人脑内&amp;#10;不可分工 · 不可校验 · 不可审计&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="260" height="120" as="geometry"/></mxCell>
