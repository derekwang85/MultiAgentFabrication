<mxCell id="judge" value="Multi-Agent 的一次决策&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;调度 · 执行 · 三权复核&amp;#10;四根梁里跑完一笔活&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="log" value="决策留痕&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;谁判的 · 基于哪条约束&amp;#10;怎么被复核的，全部落账&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="210" height="120" as="geometry"/></mxCell>
<mxCell id="ledger" value="审计账本 = 记忆&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;可随时回放来路&amp;#10;信息不凭空消失，擦除要付代价&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#99f6e4;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="600" y="80" width="250" height="130" as="geometry"/></mxCell>
<mxCell id="asset" value="知识资产沉淀&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;留痕 → 回流 → 变成规则&amp;#10;可复用的判断资产&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#99f6e4;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="240" height="130" as="geometry"/></mxCell>
<mxCell id="feedback" value="教训回流成规矩&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;账本里翻出的错&amp;#10;编译回确定性不变量&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="600" y="320" width="250" height="100" as="geometry"/></mxCell>
<mxCell id="void" value="留痕却无人审计的账&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;日志堆成仓库不看&amp;#10;记忆在那里，谁也不回放&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fecaca;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="950" y="400" width="230" height="100" as="geometry"/></mxCell>
