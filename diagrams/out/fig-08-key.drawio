<mxCell id="req" value="一次请求&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;请求 / 任务意图&amp;#10;先过门禁再谈派活&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="gate" value="规矩门禁&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;确定性不变量 · 先立规矩&amp;#10;没给门槛 = 没接得住&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="260" height="100" as="geometry"/></mxCell>
