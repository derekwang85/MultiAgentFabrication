<mxCell id="ledger" value="三权账并行&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;报告≠修复≠验证&amp;#10;每笔派活入账，交独立复核&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#99f6e4;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="900" y="170" width="260" height="140" as="geometry"/></mxCell>
<mxCell id="runaway" value="空转失控&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;无门禁直接派活&amp;#10;Agent 越转越密，账越空&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fecaca;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="610" y="420" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="e0" value="请求先进门禁" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;labelBackgroundColor=#f8fafc;fontSize=11;" edge="1" parent="1" source="req" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell>
