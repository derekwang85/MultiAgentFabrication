<mxCell id="f1" value="不可验证&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;给的是判断，不是证明；要么全信要么推倒&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fecaca;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="510" y="120" width="280" height="96" as="geometry"/></mxCell>
<mxCell id="f2" value="不可分工&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;四环合一，出错无法定位到具体环节&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fecaca;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="510" y="250" width="280" height="96" as="geometry"/></mxCell>
<mxCell id="f3" value="不可追溯&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;无留痕，出错无法复盘，错误悄悄重演&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fecaca;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="510" y="380" width="280" height="96" as="geometry"/></mxCell>
<mxCell id="sink" value="判断不可被管理&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;三缺陷叠加的必然结果&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="510" y="540" width="280" height="76" as="geometry"/></mxCell>
