<mxCell id="zone_in" value="输入侧（同一个问题，单 Agent 全包）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#64748b;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="380" height="760" as="geometry"/></mxCell>
<mxCell id="prompt" value="同一个复杂问题&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;理解 · 拆解 · 执行 · 自检，全部塞进一次前向推理&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="300" height="64" as="geometry"/></mxCell>
