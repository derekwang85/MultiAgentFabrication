<mxCell id="cand" value="候选模型集&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;本地 / SOTA / 开源 / 专有&amp;#10;一次只解决一个选型问题&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#99f6e4;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="180" height="96" as="geometry"/></mxCell>
<mxCell id="f1" value="① 严格过滤&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;硬约束硬性排他&amp;#10;不满足就淘汰，不留幸存者&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="230" height="84" as="geometry"/></mxCell>
