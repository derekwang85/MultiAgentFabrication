<mxCell id="task" value="一次判断任务&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;请求 / 任务意图&amp;#10;带约束进流程&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="agent" value="Agent 主流程&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;自动化跑通主链&amp;#10;但这才是半条闭环&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="human" value="人只在决策点进圈&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;关键闸门让人确认&amp;#10;不是全程盯梢，也不是放手不听&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="280" y="250" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="ledger" value="教训回流成规矩&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;人的一次纠正&amp;#10;编译回确定性不变量，进账留痕&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#99f6e4;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="900" y="170" width="260" height="140" as="geometry"/></mxCell>
<mxCell id="waste" value="人当摆设的浪费&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;HITL 挂名不真抓&amp;#10;人既不兜底，也不闭环&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fecaca;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="610" y="420" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="e0" value="任务进入主流程" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;labelBackgroundColor=#f8fafc;fontSize=11;" edge="1" parent="1" source="task" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="决策点交人确认" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;labelBackgroundColor=#f8fafc;fontSize=11;" edge="1" parent="1" source="agent" target="human"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="纠正编译成规矩，回流闭环" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;labelBackgroundColor=#f8fafc;fontSize=11;" edge="1" parent="1" source="human" target="ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
