<mxCell id="in" value="任务进 Swarm&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;一次判断请求&amp;#10;进入例程流程&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="p1" value="① 例程 Agent&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;起手常规处理&amp;#10;积累上下文&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="p2" value="② handoff / 工具触发&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;遇到越权就移交&amp;#10;换 Agent 或调工具&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="p3" value="③ 上下文累积&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;状态随移交滚动&amp;#10;共识逐步成形&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="280" y="250" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="p4" value="④ 多数汇合表决&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;多数观点浮出&amp;#10;但 多数 ≠ 正确&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="560" y="250" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="out" value="⑤ 产出 + 裁决留痕&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;结论进审计链&amp;#10;每一步有来路&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#99f6e4;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="880" y="170" width="260" height="140" as="geometry"/></mxCell>
<mxCell id="minority" value="少数派异议通道&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;被多数压下的一方必须留痕&amp;#10;下一步交给复核，而非沉默&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fecaca;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="880" y="380" width="260" height="100" as="geometry"/></mxCell>
