<mxfile host="app.diagrams.net" agent="MultiAgentFabrication" version="24.0.0">
<diagram id="maf" name="Page-1">
<mxGraphModel dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1620" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="root" value="容易看错的一点：Codex / TRAE / OpenClaw 运行时也会'派子 Agent'&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;表面'大家都有分身' → 于是被问：你都 subagent 了，为什么还折腾 Multi-Agent？&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#64748b;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="20" width="940" height="88" as="geometry"/></mxCell>
<mxCell id="col_sub" value="Subagent · 执行分身&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;主控临时派出的'手'（工具）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="340" y="140" width="430" height="56" as="geometry"/></mxCell>
<mxCell id="col_ma" value="Multi-Agent&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;元层/产品层，判断的责任主体（组织）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="850" y="140" width="430" height="56" as="geometry"/></mxCell>
<mxCell id="s1" value="① 架构 · 临时原语&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;依附主控，无独立结构&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="340" y="240" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="s2" value="② 生命周期 · 瞬时&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;随任务而生灭，无跨任务身份&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="340" y="370" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="s3" value="③ 决策权责 · 归主控&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;分身几乎无独立裁决权&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="340" y="500" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="s4" value="④ 大模型调用 · 复用&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;挤同一主上下文，无画像&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="340" y="630" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="s5" value="⑤ 可塑性 · 一次性&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;任务结束即消失，不可成长&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="340" y="760" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="s6" value="⑥ 记忆归属 · 用即弃&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;无跨层边界，属权不清&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="340" y="890" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="s7" value="⑦ 可证明性 · 直接采信&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;不校验分身的中间判定&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="340" y="1020" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="s8" value="⑧ 可追溯性 · 不留痕&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;决策不落账，错误悄悄重复&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="340" y="1150" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="m1" value="① 架构 · 职责主体&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;元/产品层不对称结构&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="850" y="240" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="m2" value="② 生命周期 · 持续当班&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;跨会话持续，有角色注册表&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="850" y="370" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="m3" value="③ 决策权责 · 分散可校验&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;对抗/裁决/验证三权分工&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="850" y="500" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="m4" value="④ 大模型调用 · 求解&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;声明式画像：能力/成本/速度&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="850" y="630" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="m5" value="⑤ 可塑性 · 可演进&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;k3 长期记忆沉淀复用&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="850" y="760" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="m6" value="⑥ 记忆归属 · k1-k4 分层&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;元只读 k1+k2，产品读 k1+k2+k3，k4 单向回流&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#99f6e4;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="850" y="890" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="m7" value="⑦ 可证明性 · 隔离验证+门禁&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;验证者不知修复思路，只验交付物&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="850" y="1020" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="m8" value="⑧ 可追溯性 · 有账本&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;每步落 decision.db，ADR留痕可回滚&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#99f6e4;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="850" y="1150" width="430" height="90" as="geometry"/></mxCell>
<mxCell id="verdict" value="真区别一句话：Subagent 是'主控伸出去干活的手'，Multi-Agent 是'让判断可分工、可校验、可审计的责任组织'&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;手干不干活不是重点；判断被分成谁负责、谁裁决、谁证明、谁记账 —— 这才是值得折腾 Multi-Agent 的原因&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="340" y="1310" width="940" height="110" as="geometry"/></mxCell>
