<mxCell id="spine_head" value="Multi-Agent 主线&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;多 Agent = 判断的可分工 · 可校验 · 可审计&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="280" height="64" as="geometry"/></mxCell>
<mxCell id="spine_prologue" value="序章 · 本篇&#10;&#10;&lt;font style=&quot;font-size:10px;color:#5b6475;&quot;&gt;一个不能自我证明的判断器 (A1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c7d2fe;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="280" height="64" as="geometry"/></mxCell>
